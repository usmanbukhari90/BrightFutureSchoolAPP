<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.brightfutureschool.controller.SplashController"
           stylesheets="@/css/theme.css"
           style="-fx-background-color: #E8D9C3;">

    <ImageView fx:id="watermarkLogo" fitHeight="420" fitWidth="420" opacity="0.07"/>

    <VBox fx:id="centerBox" alignment="CENTER" spacing="18">
        <ImageView fx:id="splashLogo" fitHeight="110" fitWidth="110"/>

        <HBox alignment="CENTER">
            <Label text="Bright Future " style="-fx-font-family: Georgia; -fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #7B5B3E;"/>
            <Label text="School" style="-fx-font-family: Georgia; -fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #7B5B3E;"/>
        </HBox>

        <Label text="Managing Education, Simplified" style="-fx-text-fill: #2C3E5099; -fx-font-size: 14px;"/>

        <StackPane fx:id="spinnerPane" prefWidth="60" prefHeight="60"/>

        <Label text="Loading..." style="-fx-text-fill: #2C3E50; -fx-font-size: 13px;"/>
    </VBox>

</StackPane>