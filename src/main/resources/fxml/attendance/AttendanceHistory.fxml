<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.brightfutureschool.controller.attendance.AttendanceHistoryController"
      spacing="14" prefWidth="500" prefHeight="600" style="-fx-background-color: #E8D9C3;">
    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

    <Label text="Attendance History" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

    <VBox spacing="4" styleClass="detail-card">
        <Label fx:id="studentNameLabel" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
        <Label fx:id="rollNoLabel" styleClass="detail-value"/>
        <Label fx:id="fatherNameLabel" styleClass="detail-value"/>
    </VBox>

    <Label fx:id="summaryLabel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7B5B3E;"/>

    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="130"/>
            <TableColumn fx:id="dayColumn" text="Day" prefWidth="140"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
        </columns>
    </TableView>

    <Button text="Close" onAction="#onClose" maxWidth="Infinity"/>
</VBox>