<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.brightfutureschool.controller.info.PoweredByGateController"
      spacing="14" alignment="CENTER" prefWidth="380" prefHeight="340" style="-fx-background-color: #E8D9C3;">
    <padding><Insets top="30" right="30" bottom="25" left="30"/></padding>

    <ImageView fitWidth="70" fitHeight="70" preserveRatio="true">
        <Image url="@/images/gate_logo.png"/>
    </ImageView>

    <Label text="Gate" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #7B5B3E; -fx-font-family: 'Georgia';"/>
    <Label text="Custom Software Solutions" style="-fx-font-size: 12px; -fx-text-fill: #555555;"/>

    <Separator/>

    <Label text="This application was designed and developed by Gate."
           wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #2C3E50;" textAlignment="CENTER"/>

    <Label fx:id="whatsappLabel" text="For support, feature requests, or new projects, feel free to reach out."
           wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #2C3E50;" textAlignment="CENTER"/>

    <Button text="💬 Message on WhatsApp" styleClass="button-primary" onAction="#onMessageOnWhatsApp" maxWidth="Infinity"/>
    <Button text="Close" onAction="#onClose" maxWidth="Infinity"/>
</VBox>