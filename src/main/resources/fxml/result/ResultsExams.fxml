<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.brightfutureschool.controller.result.ResultsExamsController"
      spacing="15">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Exams &amp; Results" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Class:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="classComboBox" prefWidth="200"/>
    </HBox>

    <VBox fx:id="examsView" spacing="15">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Exams for this class" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ToggleButton fx:id="deleteModeToggle" text="🗑 Delete Exam" onAction="#onToggleDeleteMode"
                          style="-fx-text-fill: #E74C3C;"/>
            <Button text="+ Create Exam" styleClass="button-primary" onAction="#onCreateExam"/>
        </HBox>
        <Label fx:id="examsHintLabel" style="-fx-font-size: 12px; -fx-text-fill: #7B5B3E;" wrapText="true"/>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <FlowPane fx:id="examsFlow" hgap="15" vgap="15"/>
        </ScrollPane>
    </VBox>
he
    <VBox fx:id="marksView" spacing="15" visible="false" managed="false" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button text="&lt; Back to Exams" onAction="#onBackToExams"/>
            <Label fx:id="marksHeaderLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search by name or roll no" onAction="#onSearch"/>
            <Button text="Search" onAction="#onSearch"/>
            <Button fx:id="editToggleButton" text="✏ Edit Results" onAction="#onToggleEdit"/>
        </HBox>

        <TableView fx:id="marksTable" VBox.vgrow="ALWAYS"/>
    </VBox>

</VBox>