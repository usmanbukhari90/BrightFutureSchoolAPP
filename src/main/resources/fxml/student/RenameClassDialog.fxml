<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.brightfutureschool.controller.student.RenameClassDialogController"
      spacing="12" styleClass="root">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Edit Class Name" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <Label fx:id="currentLabel" style="-fx-font-size: 12px; -fx-text-fill: #7B5B3E;" wrapText="true"/>

    <Label text="Class Name (e.g. Nursery, KG, Class 1, Class 8)"/>
    <TextField fx:id="classNameField" onAction="#onSave"/>

    <Label text="Section (e.g. A, B, C)"/>
    <TextField fx:id="sectionField" onAction="#onSave"/>

    <Label text="All students and records in this class stay exactly as they are."
           style="-fx-font-size: 11px; -fx-text-fill: #7B5B3E;" wrapText="true"/>
    <Label fx:id="statusLabel" style="-fx-text-fill: #E74C3C;" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#onCancel"/>
        <Button text="Save Changes" styleClass="button-primary" onAction="#onSave"/>
    </HBox>
</VBox>
