<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.brightfutureschool.controller.teacher.TeacherDetailDialogController"
            fitToWidth="true" prefWidth="500" prefHeight="680"
            style="-fx-background-color: #F3E9DC;">

    <VBox spacing="16" style="-fx-padding: 22; -fx-background-color: #F3E9DC;">

        <Label text="Teacher Details" style="-fx-font-family: 'Georgia'; -fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #7B5B3E;"/>

        <!-- Photo section -->
        <HBox spacing="18" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 15;">
            <StackPane style="-fx-background-color: #E8D9C3; -fx-background-radius: 10;" prefWidth="100" prefHeight="100">
                <ImageView fx:id="photoView" fitWidth="100" fitHeight="100" preserveRatio="true"/>
            </StackPane>
            <VBox spacing="6">
                <Button text="📷 Choose Photo" onAction="#onChoosePhoto"/>
                <Label text="Sr. No" style="-fx-font-size: 10px; -fx-opacity: 0.6;"/>
                <Label fx:id="srNoLabel" style="-fx-font-weight: bold; -fx-text-fill: #7B5B3E;"/>
            </VBox>
        </HBox>

        <!-- Personal Info -->
        <VBox spacing="8" styleClass="card" style="-fx-padding: 15;">
            <Label text="Personal Information" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7B5B3E;"/>
            <Label text="Full Name" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
            <TextField fx:id="fullNameField"/>
            <Label text="Father Name" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
            <TextField fx:id="fatherNameField"/>
            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Contact" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
                    <TextField fx:id="contactField"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Date of Birth" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
                    <TextField fx:id="dobField" promptText="yyyy-MM-dd"/>
                </VBox>
            </HBox>
            <Label text="CNIC Number" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
            <TextField fx:id="cnicField" promptText="xxxxx-xxxxxxx-x"/>
            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Nationality" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
                    <TextField fx:id="nationalityField"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Religion" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
                    <TextField fx:id="religionField"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Professional Info -->
        <VBox spacing="8" styleClass="card" style="-fx-padding: 15;">
            <Label text="Professional Information" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7B5B3E;"/>
            <Label text="Qualification" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
            <TextArea fx:id="qualificationField" prefRowCount="2" wrapText="true"/>
            <Label text="Previous Experience" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
            <TextArea fx:id="experienceField" prefRowCount="2" wrapText="true"/>
            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Assigned Class" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
                    <ComboBox fx:id="classDropdown" maxWidth="Infinity" promptText="Select Class (optional)"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Proficient Subject" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
                    <TextField fx:id="subjectField"/>
                </VBox>
            </HBox>
            <Label text="Fixed Salary (Rs.)" style="-fx-font-size: 11px; -fx-opacity: 0.7;"/>
            <TextField fx:id="salaryField"/>
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #E74C3C;" wrapText="true" managed="false" visible="false"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Cancel" onAction="#onCancel"/>
            <Button text="Save" styleClass="button-primary" onAction="#onSave"/>
        </HBox>
    </VBox>

</ScrollPane>